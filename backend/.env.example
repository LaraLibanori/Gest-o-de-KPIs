# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# A API conecta com o role kpi_api, criado pela migration 0004. Ele nao ignora
# RLS e só tem acesso às três tabelas.
DATABASE_URL=postgresql://kpi_api.xxxxxxxx:SENHA_DO_KPI_APP@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Só o Alembic usa postgres, e no session pooler (porta 5432): em modo
# transaction o pooler troca de backend a cada transação. Não vai para a Vercel.
MIGRATIONS_DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Senha do role kpi_api. Usada só pela migration que cria o role.
KPI_APP_PASSWORD=

# Origem liberada no CORS, só usada quando o backend roda em porta separada.
# O `make dev` já define, então normalmente fica de fora daqui.
# FRONTEND_ORIGIN=http://localhost:3000

# Chave Fernet que cifra a senha das conexões. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Senha do usuário de leitura da base de exemplo (make exemplo).
DEMO_LEITOR_PASSWORD=
